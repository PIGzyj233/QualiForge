COMPOSE_PROJECT_NAME=qualiforge

POSTGRES_DB=qualiforge
POSTGRES_USER=qualiforge
POSTGRES_PASSWORD=qualiforge

QUALIFORGE_ENVIRONMENT=local
QUALIFORGE_SECRET_KEY=change-me-before-deploy
QUALIFORGE_DATABASE_URL=postgresql://qualiforge:qualiforge@postgres:5432/qualiforge
QUALIFORGE_REDIS_URL=redis://redis:6379/0
QUALIFORGE_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
QUALIFORGE_GIT_SANDBOX_ROOT=/data/git-sandbox
QUALIFORGE_GIT_SYNC_TIMEOUT_SECONDS=120
QUALIFORGE_GIT_REPO_SIZE_LIMIT_MB=1024
QUALIFORGE_GIT_DIFF_FILE_LIMIT=500
QUALIFORGE_IMPORT_STORAGE_ROOT=/data/imports
